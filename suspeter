    local function filterPlayers()
        local query = searchBox.Text:lower()
        clearBtn.Visible = query ~= ""

        local visiveis = 0
        for _, child in ipairs(scrolling:GetChildren()) do
            if child:IsA("TextButton") then
                local name = child.Name:lower()
                local displayName = ""
                if child:FindFirstChild("DisplayLabel") then
                    displayName = child.DisplayLabel.Text:lower()
                end
                local matches = name:find(query, 1, true) or displayName:find(query, 1, true)
                child.Visible = matches
                if matches then visiveis = visiveis + 1 end
            end
        end

        counter.Text = visiveis .. " jogador" .. (visiveis == 1 and "" or "es") .. " visível" .. (visiveis == 1 and "" or "is")

        task.wait()
        scrolling.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end

