        weldPonta.Part0 = ultimoSeg
        weldPonta.Part1 = ponta
        weldPonta.Parent = ponta
        table.insert(dados.partes, ponta)
    end

    if targetPlayer.Character then
        dados.roupas = salvarRoupas(targetPlayer.Character)
        removerRoupas(targetPlayer.Character)
        setupCilindroDuro()
    end

    dados.charConnection = targetPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        dados.roupas = salvarRoupas(targetPlayer.Character)
        removerRoupas(targetPlayer.Character)
