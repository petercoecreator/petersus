        local pinkRight = createPart(Vector3.new(0.35, 0.35, 0.35), pink, workspace)
        local backLeft = createPart(Vector3.new(1.4, 1.4, 1.4), skinColor, workspace)
        local backRight = createPart(Vector3.new(1.4, 1.4, 1.4), skinColor, workspace)

        local t = 0

        swayConnectionLocal = RunService.RenderStepped:Connect(function(dt)
            if not char.Parent then return end
            t += dt
            local moving = hum and hum.MoveDirection.Magnitude > 0.1
            local speed = moving and 10 or 4
            local amount = moving and 0.18 or 0.05
            local bounce = moving and 0.08 or 0.02

            -- Balanço sincronizado com o vai-e-vem do Bang
            local bangSway = 0
            local bangUp = 0
            local bangRot = 0
            if bangMovimentoAtivo then
                -- bangProgresso: 0 = longe, 0.5 = meio, 1 = perto
                -- O peito balança para frente quando vai (progresso aumenta) e volta quando recua
                local pulso = math.sin(bangProgresso * math.pi)  -- 0 → 1 → 0
                local intenso = 1 - math.abs(bangProgresso - 0.5) * 2  -- máximo no meio

                bangSway = math.sin(t * 3) * 0.08 * intenso  -- leve balanço lateral natural
                bangUp = pulso * 0.22  -- sobe/desce com o vai-e-vem
                bangRot = pulso * 18   -- inclina com o movimento
            end

            local sway = math.sin(t * speed) * amount + bangSway
            local up = math.abs(math.cos(t * speed * 0.7)) * bounce + bangUp

            frontLeft.CFrame = torso.CFrame * CFrame.new(-0.6 + sway, 0.2 - up, -0.9) * CFrame.Angles(0, 0, math.rad(sway * 40 + bangRot))
            frontRight.CFrame = torso.CFrame * CFrame.new(0.6 - sway, 0.2 - up, -0.9) * CFrame.Angles(0, 0, math.rad(-sway * 40 - bangRot))
            pinkLeft.CFrame = frontLeft.CFrame * CFrame.new(0, 0, -0.75)
            pinkRight.CFrame = frontRight.CFrame * CFrame.new(0, 0, -0.75)
            backLeft.CFrame = torso.CFrame * CFrame.new(-0.45, -0.85 + sway * 0.2, 0.7)
            backRight.CFrame = torso.CFrame * CFrame.new(0.45, -0.85 - sway * 0.2, 0.7)
        end)
    end

    if player.Character then addPartsToSelf() end
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        addPartsToSelf()
    end)
end

