local function executarScriptHomem()
    selectorGui:Destroy()
    modoAtual = "homem"

    if player.Character then
        roupasJogadorLocal = salvarRoupas(player.Character)
    end

    if player.Character then
        setupPintoLocal()
    end

    if player.Character then removerRoupas(player.Character) end

    local function conectarHumanoid()
        local character = player.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end

        if humanoidConnection then
            humanoidConnection:Disconnect()
            humanoidConnection = nil
        end

        humanoidConnection = humanoid.Died:Connect(function()
            limparTudo()
        end)
    end

    conectarHumanoid()
    local charConn = player.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        limparTudo()
    end)
    table.insert(conexoes, charConn)

    local fConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.F then
            pintoLocal.estaRigido = not pintoLocal.estaRigido
            local character = player.Character
            if not character then return end
            local rootPart = character:WaitForChild("HumanoidRootPart")

            if pintoLocal.estaRigido then
                for i, seg in ipairs(pintoLocal.segmentos) do
                    local offsetZ = -0.7 - (i * alturaSegmento)
                    seg.CFrame = rootPart.CFrame * CFrame.new(0, -1.1, offsetZ) * CFrame.Angles(0, math.rad(90), 0)
                    local w = Instance.new("WeldConstraint")
                    w.Part0 = (i == 1) and rootPart or pintoLocal.segmentos[i-1]
                    w.Part1 = seg
                    w.Parent = seg
                    table.insert(pintoLocal.weldsDeRigidez, w)
                end
            else
                for _, w in ipairs(pintoLocal.weldsDeRigidez) do w:Destroy() end
                pintoLocal.weldsDeRigidez = {}
            end
        end
    end)
    table.insert(conexoes, fConn)

    -- BANGSCRIPT MASCULINO (tecla H)
    local bangConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.H then
            if bangMovimentoAtivo then
                pararBang()
                print("⏹ Bang parado")
            else
                iniciarBangMasculino()
                if bangMovimentoAtivo then
                    print("🔥 Bang iniciado (de costas): " .. (bangAlvo and bangAlvo.Name or "alvo"))
                end
            end
        end
    end)
    table.insert(conexoes, bangConn)

    local deleteConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.Delete then
            limparTudo()
        end
    end)
    table.insert(conexoes, deleteConn)


    -- SISTEMA DE JATO BRANCO (tecla J)
    local jatoAtivo = false
    local jatoParticulas = nil

    local function criarJato()
        local character = player.Character
        if not character then return end

        -- Encontrar a ponta do pinto
        local ponta = character:FindFirstChild("PontaRedonda")
        if not ponta then return end

        -- Criar partículas
        local attachment = Instance.new("Attachment")
        attachment.Name = "JatoAttachment"
        attachment.Position = Vector3.new(0, 0, 0.5) -- na ponta
        attachment.Parent = ponta

        local particulas = Instance.new("ParticleEmitter")
        particulas.Name = "JatoBranco"
        particulas.Color = ColorSequence.new(Color3.new(1, 1, 1))
        particulas.Size = NumberSequence.new(0.3, 0.1)
        particulas.Transparency = NumberSequence.new(0.2, 1)
        particulas.Lifetime = NumberRange.new(0.5, 1)
        particulas.Rate = 100
        particulas.Speed = NumberRange.new(8, 15)
        particulas.SpreadAngle = Vector2.new(15, 15)
        particulas.Acceleration = Vector3.new(0, -5, 0)
        particulas.Parent = attachment

        -- Luz na ponta
        local luz = Instance.new("PointLight")
        luz.Name = "JatoLight"
        luz.Color = Color3.new(1, 1, 1)
        luz.Brightness = 2
        luz.Range = 5
        luz.Parent = ponta

        jatoParticulas = {attachment = attachment, particulas = particulas, luz = luz}
    end

    local function destruirJato()
        if jatoParticulas then
            if jatoParticulas.attachment then jatoParticulas.attachment:Destroy() end
            if jatoParticulas.luz then jatoParticulas.luz:Destroy() end
            jatoParticulas = nil
        end
    end

    local jConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.J then
            jatoAtivo = not jatoAtivo
            if jatoAtivo then
                criarJato()
                print("💦 Jato ativado!")
            else
                destruirJato()
                print("⏹ Jato desativado!")
            end
        end
    end)
    table.insert(conexoes, jConn)

    -- Limpar jato ao morrer/resetar
    local jatoCleanConn = player.CharacterAdded:Connect(function()
        if jatoAtivo then
            jatoAtivo = false
            destruirJato()
        end
    end)
    table.insert(conexoes, jatoCleanConn)

    criarPlayerSelectGUI("Adicionar Peito", "homem")
end

