            local novaPos = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
            frame.Position = novaPos
            guiPosicaoOriginal = novaPos
        end
    end)

