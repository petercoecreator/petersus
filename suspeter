local function getJogadorMaisProximoBang()
    local meuChar = player.Character
    if not meuChar then return nil end
    local meuRoot = meuChar:FindFirstChild("HumanoidRootPart")
    if not meuRoot then return nil end

    local maisProximo = nil
    local menorDistancia = 50

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (meuRoot.Position - root.Position).Magnitude
                if dist < menorDistancia then
                    menorDistancia = dist
                    maisProximo = plr
                end
            end
        end
    end

    return maisProximo
end

local function congelarAnimacao(character, congelar)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if congelar then
            humanoid.AutoRotate = false
        else
            humanoid.AutoRotate = true
        end
    end
    local animate = character:FindFirstChild("Animate")
    if animate and animate:IsA("LocalScript") then
        animate.Enabled = not congelar
    end
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if congelar then
                track:AdjustSpeed(0)
            else
                track:AdjustSpeed(1)
            end
        end
    end
end

local function pararBang()
    bangMovimentoAtivo = false
    bangAlvo = nil
    bangProgresso = 0
    if bangConexao then
        bangConexao:Disconnect()
        bangConexao = nil
    end
    -- Restaurar animação do personagem
    local char = player.Character
    if char then
        congelarAnimacao(char, false)
    end
end

-- BANGSCRIPT MASCULINO (atrás, de costas)
local function iniciarBangMasculino()
    bangAlvo = getJogadorMaisProximoBang()
    if not bangAlvo then
        warn("Nenhum jogador próximo para bang!")
        return
    end

    -- Congelar animação do personagem
    local char = player.Character
    if char then
        congelarAnimacao(char, true)
    end

    bangMovimentoAtivo = true
    local estadoFrente = true
    local progresso = 0
    local posicaoAtual = nil

    bangConexao = RunService.RenderStepped:Connect(function(dt)
        if not bangAlvo or not bangAlvo.Character then
            pararBang()
            return
        end

        local meuChar = player.Character
        if not meuChar then
            pararBang()
            return
        end

        local meuRoot = meuChar:FindFirstChild("HumanoidRootPart")
        local alvoRoot = bangAlvo.Character:FindFirstChild("HumanoidRootPart")

        if not meuRoot or not alvoRoot then
            pararBang()
            return
        end

        local posAtras = alvoRoot.CFrame * CFrame.new(0, 0, BANG_M_DISTANCIA_ATRAS)
        local posFrente = alvoRoot.CFrame * CFrame.new(0, 0, BANG_M_DISTANCIA_FRENTE)

        if not posicaoAtual then
            posicaoAtual = posAtras.Position
        end

        local velocidade = estadoFrente and BANG_M_VELOCIDADE_FRENTE or BANG_M_VELOCIDADE_TRAS
        progresso += dt * velocidade

        if progresso >= 1 then
            progresso = 0
            estadoFrente = not estadoFrente
            posicaoAtual = estadoFrente and posAtras.Position or posFrente.Position
        end

        local t = progresso
        local suave = t * t * (3 - 2 * t)

        -- EXPOR progresso para sincronização
        bangProgresso = suave

        local destino = estadoFrente and posFrente.Position or posAtras.Position
        local origem = estadoFrente and posAtras.Position or posFrente.Position

        posicaoAtual = origem:Lerp(destino, suave)

        local intenso = 1 - math.abs(suave - 0.5) * 2
        local balancoY = math.sin(tick() * 8) * BANG_M_AMPLETUDE_VERTICAL * intenso
        local balancoX = math.cos(tick() * 6) * BANG_M_AMPLETUDE_LATERAL * intenso

        local posFinal = posicaoAtual + Vector3.new(balancoX, balancoY, 0)

        -- DE COSTAS PARA O ALVO
        local direcao = alvoRoot.Position - posFinal
        local anguloY = math.atan2(direcao.X, direcao.Z) + math.pi

        local inclinacao = (estadoFrente and 0.08 or -0.05) * intenso

        meuRoot.CFrame = CFrame.new(posFinal) * CFrame.Angles(inclinacao, anguloY, 0)
    end)
end

-- BANGIRL FEMININO (na frente, de frente)
local function iniciarBangFeminino()
    bangAlvo = getJogadorMaisProximoBang()
    if not bangAlvo then
        warn("Nenhum jogador próximo para bang!")
        return
    end

    -- Congelar animação do personagem
    local char = player.Character
    if char then
        congelarAnimacao(char, true)
    end

    bangMovimentoAtivo = true
    local estadoFrente = true
    local progresso = 0
    local posicaoAtual = nil

    bangConexao = RunService.RenderStepped:Connect(function(dt)
        if not bangAlvo or not bangAlvo.Character then
            pararBang()
            return
        end

        local meuChar = player.Character
        if not meuChar then
            pararBang()
            return
        end

        local meuRoot = meuChar:FindFirstChild("HumanoidRootPart")
        local alvoRoot = bangAlvo.Character:FindFirstChild("HumanoidRootPart")

        if not meuRoot or not alvoRoot then
            pararBang()
            return
        end

        local posLonge = alvoRoot.CFrame * CFrame.new(0, 0, -BANG_F_DISTANCIA_FRENTE)
        local posPerto = alvoRoot.CFrame * CFrame.new(0, 0, -BANG_F_DISTANCIA_PERTO)

        if not posicaoAtual then
            posicaoAtual = posLonge.Position
        end

        local velocidade = estadoFrente and BANG_F_VELOCIDADE_FRENTE or BANG_F_VELOCIDADE_TRAS
        progresso += dt * velocidade

        if progresso >= 1 then
            progresso = 0
            estadoFrente = not estadoFrente
            posicaoAtual = estadoFrente and posLonge.Position or posPerto.Position
        end

        local t = progresso
        local suave = t * t * (3 - 2 * t)

        -- EXPOR progresso para sincronização dos peitos
        bangProgresso = suave

        local destino = estadoFrente and posPerto.Position or posLonge.Position
        local origem = estadoFrente and posLonge.Position or posPerto.Position

        posicaoAtual = origem:Lerp(destino, suave)

        local intenso = 1 - math.abs(suave - 0.5) * 2
        local balancoY = math.sin(tick() * 8) * BANG_F_AMPLETUDE_VERTICAL * intenso
        local balancoX = math.cos(tick() * 6) * BANG_F_AMPLETUDE_LATERAL * intenso

        local posFinal = posicaoAtual + Vector3.new(balancoX, balancoY, 0)

        -- DE FRENTE PARA O ALVO
        local direcao = alvoRoot.Position - posFinal
        local anguloY = math.atan2(direcao.X, direcao.Z)

        local inclinacao = (estadoFrente and -0.08 or 0.05) * intenso

        meuRoot.CFrame = CFrame.new(posFinal) * CFrame.Angles(inclinacao, anguloY, 0)
    end)
end

