            local esfera = Instance.new("Part")
            esfera.Name = "EsferaFixa"
            esfera.Shape = Enum.PartType.Ball
            esfera.Size = Vector3.new(1.1, 1.1, 1.1)
            esfera.Color = skinColor
            esfera.Material = materialLiso
            esfera.CanCollide = false
            esfera.Parent = character
            esfera.CFrame = rootPart.CFrame * offset

            local weld = Instance.new("WeldConstraint")
            weld.Part0 = rootPart
            weld.Part1 = esfera
            weld.Parent = esfera

            table.insert(dados.partes, esfera)
            return esfera
