-- ============================================
-- FUNÇÃO TWEEN
-- ============================================
local function tween(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- ============================================
-- FUNÇÕES AUXILIARES
-- ============================================
local function getSkinColor(char)
    local bodyColors = char:FindFirstChildOfClass("BodyColors")
    if bodyColors then return bodyColors.TorsoColor3 end
    local torso = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
    if torso then return torso.Color end
    local head = char:FindFirstChild("Head")
    if head then return head.Color end
    return Color3.fromRGB(255, 204, 153)
end

-- ============================================
-- SISTEMA DE ROUPAS - SALVAR E RESTAURAR
-- ============================================
local function salvarRoupas(character)
    local dados = {}
    for _, item in pairs(character:GetChildren()) do
        if item:IsA("Shirt") then
            dados.Shirt = item.ShirtTemplate
        elseif item:IsA("Pants") then
            dados.Pants = item.PantsTemplate
        elseif item:IsA("ShirtGraphic") then
            dados.ShirtGraphic = item.Graphic
        end
    end
    return dados
end

local function removerRoupas(character)
    for _, item in pairs(character:GetChildren()) do
        if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") then
            item:Destroy()
        end
    end
end

local function restaurarRoupas(character, dados)
    if not dados then return end
    if dados.Shirt then
        local shirt = Instance.new("Shirt")
        shirt.ShirtTemplate = dados.Shirt
        shirt.Parent = character
    end
    if dados.Pants then
        local pants = Instance.new("Pants")
        pants.PantsTemplate = dados.Pants
        pants.Parent = character
    end
    if dados.ShirtGraphic then
        local graphic = Instance.new("ShirtGraphic")
        graphic.Graphic = dados.ShirtGraphic
        graphic.Parent = character
    end
end

-- ============================================
-- LIMPAR TUDO (DELETE OU MORRER)
-- ============================================
local function limparTudo()
    -- Para bangscript/bangirl
    pararBang()

    if guiAtual and guiAtual.Parent then
        guiAtual:Destroy()
    end
    guiAtual = nil
    guiFramePrincipal = nil
    guiMinimizado = false
    guiPosicaoOriginal = nil
    guiTamanhoOriginal = nil

    for _, conn in ipairs(conexoes) do
        if conn then conn:Disconnect() end
    end
    conexoes = {}

    if humanoidConnection then
        humanoidConnection:Disconnect()
        humanoidConnection = nil
    end

    for _, obj in ipairs(pintoLocal.partes) do
        if obj and obj.Parent then obj:Destroy() end
    end
    pintoLocal.segmentos = {}
    pintoLocal.weldsDeRigidez = {}
    pintoLocal.estaRigido = false
    pintoLocal.partes = {}

    if swayConnectionLocal then
        swayConnectionLocal:Disconnect()
        swayConnectionLocal = nil
    end
    for _, part in ipairs(selectedPartsLocal) do
        if part and part.Parent then part:Destroy() end
    end
    selectedPartsLocal = {}

    -- Restaurar roupas do jogador local
    if player.Character and roupasJogadorLocal then
        restaurarRoupas(player.Character, roupasJogadorLocal)
        roupasJogadorLocal = nil
    end

    for targetPlayer, dados in pairs(jogadoresComPinto) do
        for _, obj in ipairs(dados.partes) do
            if obj and obj.Parent then obj:Destroy() end
        end
        if targetPlayer.Character and dados.roupas then
            restaurarRoupas(targetPlayer.Character, dados.roupas)
        end
        if dados.charConnection then
            dados.charConnection:Disconnect()
        end
    end
    jogadoresComPinto = {}

    for targetPlayer, dados in pairs(jogadoresComBolas) do
        if dados.swayConnection then
            dados.swayConnection:Disconnect()
        end
        for _, part in ipairs(dados.partes) do
            if part and part.Parent then part:Destroy() end
        end
        if targetPlayer.Character and dados.roupas then
            restaurarRoupas(targetPlayer.Character, dados.roupas)
        end
        if dados.charConnection then
            dados.charConnection:Disconnect()
        end
    end
    jogadoresComBolas = {}

    modoAtual = nil
    roupasJogadorLocal = nil
end

-- ============================================
-- ADICIONAR PELOS (PINTO)
-- ============================================
local function adicionarPelos(parte, ehEsfera, character)
    for i = 1, densidadePelos do
        local pelo = Instance.new("Part")
        pelo.Name = "Pelo"
        local comprimentoAleatorio = 0.2 + (math.random() * 0.15)
        pelo.Size = Vector3.new(larguraPelo, comprimentoAleatorio, larguraPelo)
        pelo.Color = corPelo
        pelo.Material = materialLiso
        pelo.CanCollide = false
        pelo.Parent = character

        local direcao
        if ehEsfera then
            local angulo1 = math.rad(math.random(0, 360))
            local angulo2 = math.rad(math.random(0, 360))
            direcao = Vector3.new(
                math.sin(angulo1) * math.cos(angulo2),
                math.sin(angulo1) * math.sin(angulo2),
                math.cos(angulo1)
            )
            pelo.CFrame = (parte.CFrame * CFrame.new(direcao * (parte.Size.X/2))) * CFrame.lookAt(Vector3.new(0,0,0), direcao) * CFrame.Angles(math.rad(90), 0, 0)
        else
            local angulo = math.rad(math.random(0, 360))
            local posAoLongo = (math.random() - 0.5) * parte.Size.X
            local raio = parte.Size.Y / 2
            local localPos = Vector3.new(posAoLongo, math.cos(angulo) * raio, math.sin(angulo) * raio)
            direcao = (localPos * Vector3.new(0, 1, 1)).Unit
            pelo.CFrame = parte.CFrame * CFrame.new(localPos) * CFrame.lookAt(Vector3.new(0,0,0), direcao) * CFrame.Angles(math.rad(90), 0, 0)
        end

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = parte
        weld.Part1 = pelo
        weld.Parent = pelo
    end
end

-- ============================================
-- PINTO NO JOGADOR LOCAL (MODO HOMEM) - SEM COLISÃO
-- ============================================
local function setupPintoLocal()
    local character = player.Character
    if not character then return end
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local skinColor = getSkinColor(character)

    for _, obj in pairs(character:GetChildren()) do
        if obj.Name == "EsferaFixa" or obj.Name == "ParteFlexivel" or obj.Name == "PontaRedonda" or obj.Name == "Pelo" then
            obj:Destroy()
        end
    end

    pintoLocal.segmentos = {}
    pintoLocal.weldsDeRigidez = {}
    pintoLocal.partes = {}

    local function criarEsferaBase(nome, offset)
        local esfera = Instance.new("Part")
        esfera.Name = "EsferaFixa"
        esfera.Shape = Enum.PartType.Ball
        esfera.Size = Vector3.new(1.1, 1.1, 1.1)
        esfera.Color = skinColor
        esfera.Material = materialLiso
        esfera.CanCollide = false
        esfera.Parent = character
        esfera.CFrame = rootPart.CFrame * offset

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rootPart
        weld.Part1 = esfera
        weld.Parent = esfera

        adicionarPelos(esfera, true, character)
        table.insert(pintoLocal.partes, esfera)
        return esfera
    end

    criarEsferaBase("E_Esq", CFrame.new(-0.55, -1.1, -0.6))
    criarEsferaBase("E_Dir", CFrame.new(0.55, -1.1, -0.6))

    local ultimoAncoradouro = rootPart
    local posicaoAncoragem = Vector3.new(0, -1.1, -0.7)

    for i = 1, numSegmentos do
        local segmento = Instance.new("Part")
        segmento.Name = "ParteFlexivel"
        segmento.Shape = Enum.PartType.Cylinder
        segmento.Size = Vector3.new(alturaSegmento, larguraCilindro, larguraCilindro)
        segmento.Material = materialLiso
        segmento.Color = skinColor
        if i < numSegmentos then adicionarPelos(segmento, false, character) end
        segmento.CanCollide = false
        segmento.Parent = character
        segmento.CFrame = rootPart.CFrame * CFrame.new(0, -1.1, -0.7 - (i * alturaSegmento)) * CFrame.Angles(0, math.rad(90), 0)

        local att0 = Instance.new("Attachment")
        att0.Parent = ultimoAncoradouro
        att0.Position = (ultimoAncoradouro == rootPart) and posicaoAncoragem or Vector3.new(alturaSegmento/2, 0, 0)

        local att1 = Instance.new("Attachment")
        att1.Parent = segmento
        att1.Position = Vector3.new(-alturaSegmento/2, 0, 0)

        local socket = Instance.new("BallSocketConstraint")
        socket.Attachment0 = att0
        socket.Attachment1 = att1
        socket.Parent = segmento
        socket.LimitsEnabled = true
        socket.UpperAngle = 20

        table.insert(pintoLocal.segmentos, segmento)
        table.insert(pintoLocal.partes, segmento)
        ultimoAncoradouro = segmento
    end

    local ultimoSeg = pintoLocal.segmentos[#pintoLocal.segmentos]
    local ponta = Instance.new("Part")
    ponta.Name = "PontaRedonda"
    ponta.Shape = Enum.PartType.Ball
    ponta.Size = Vector3.new(larguraCilindro, larguraCilindro, larguraCilindro)
    ponta.Color = corRosa
    ponta.Material = materialLiso
    ponta.CanCollide = false
    ponta.Parent = character
    ponta.CFrame = ultimoSeg.CFrame * CFrame.new(alturaSegmento/2, 0, 0)

    local weldPonta = Instance.new("WeldConstraint")
    weldPonta.Part0 = ultimoSeg
    weldPonta.Part1 = ponta
    weldPonta.Parent = ponta
    table.insert(pintoLocal.partes, ponta)
end

-- ============================================
-- APLICAR 4 BOLAS ANIMADAS NO JOGADOR ALVO (MODO HOMEM)
-- ============================================
local function aplicarBolasNoJogador(targetPlayer)
    if jogadoresComBolas[targetPlayer] then
        local dadosAntigos = jogadoresComBolas[targetPlayer]
        if dadosAntigos.swayConnection then
            dadosAntigos.swayConnection:Disconnect()
        end
        for _, part in ipairs(dadosAntigos.partes) do
            if part and part.Parent then part:Destroy() end
        end
        if dadosAntigos.charConnection then
            dadosAntigos.charConnection:Disconnect()
        end
        if targetPlayer.Character and dadosAntigos.roupas then
            restaurarRoupas(targetPlayer.Character, dadosAntigos.roupas)
        end
        jogadoresComBolas[targetPlayer] = nil
    end

    local dados = {
        partes = {},
        swayConnection = nil,
        charConnection = nil,
        roupas = nil
    }

    local function clearParts()
        if dados.swayConnection then
            dados.swayConnection:Disconnect()
            dados.swayConnection = nil
        end
        for _, part in ipairs(dados.partes) do
            if part and part.Parent then part:Destroy() end
        end
        dados.partes = {}
    end

    local function createPart(size, color, parent)
        local part = Instance.new("Part")
        part.Shape = Enum.PartType.Ball
        part.Size = size
        part.Color = color
        part.Material = Enum.Material.SmoothPlastic
        part.CanCollide = false
        part.Anchored = true
        part.Parent = parent
        table.insert(dados.partes, part)
        return part
    end

    local function addPartsToTarget()
        clearParts()
        local char = targetPlayer.Character
        if not char then return end
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not torso then return end

        local skinColor = getSkinColor(char)
        local pink = Color3.fromRGB(255, 170, 190)

        local frontLeft = createPart(Vector3.new(1.6, 1.6, 1.6), skinColor, workspace)
        local frontRight = createPart(Vector3.new(1.6, 1.6, 1.6), skinColor, workspace)
        local pinkLeft = createPart(Vector3.new(0.35, 0.35, 0.35), pink, workspace)
        local pinkRight = createPart(Vector3.new(0.35, 0.35, 0.35), pink, workspace)
        local backLeft = createPart(Vector3.new(1.4, 1.4, 1.4), skinColor, workspace)
        local backRight = createPart(Vector3.new(1.4, 1.4, 1.4), skinColor, workspace)

        local t = 0

        dados.swayConnection = RunService.RenderStepped:Connect(function(dt)
            if not char.Parent then return end
            t += dt
            local moving = hum and hum.MoveDirection.Magnitude > 0.1
            local speed = moving and 10 or 4
            local amount = moving and 0.18 or 0.05
            local bounce = moving and 0.08 or 0.02

            -- Balanço sincronizado com o vai-e-vem do Bang no jogador local
            local bangSway = 0
            local bangUp = 0
            local bangRot = 0
            if bangMovimentoAtivo then
                local pulso = math.sin(bangProgresso * math.pi)
                local intenso = 1 - math.abs(bangProgresso - 0.5) * 2

                bangSway = math.sin(t * 3) * 0.08 * intenso
                bangUp = pulso * 0.22
                bangRot = pulso * 18
            end

            local sway = math.sin(t * speed) * amount + bangSway
            local up = math.abs(math.cos(t * speed * 0.7)) * bounce + bangUp

            frontLeft.CFrame = torso.CFrame * CFrame.new(-0.6 + sway, 0.2 - up, -0.9) * CFrame.Angles(0, 0, math.rad(sway * 40 + bangRot))
            frontRight.CFrame = torso.CFrame * CFrame.new(0.6 - sway, 0.2 - up, -0.9) * CFrame.Angles(0, 0, math.rad(-sway * 40 - bangRot))
            pinkLeft.CFrame = frontLeft.CFrame * CFrame.new(0, 0, -0.75)
            pinkRight.CFrame = frontRight.CFrame * CFrame.new(0, 0, -0.75)
            backLeft.CFrame = torso.CFrame * CFrame.new(-0.45, -0.85 + sway * 0.2, 0.7)
            backRight.CFrame = torso.CFrame * CFrame.new(0.45, -0.85 - sway * 0.2, 0.7)
        end)
    end

    if targetPlayer.Character then
        dados.roupas = salvarRoupas(targetPlayer.Character)
        removerRoupas(targetPlayer.Character)
        addPartsToTarget()
    end

    dados.charConnection = targetPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        dados.roupas = salvarRoupas(targetPlayer.Character)
        removerRoupas(targetPlayer.Character)
        addPartsToTarget()
    end)

    jogadoresComBolas[targetPlayer] = dados
end

local function removerBolasERestaurarRoupas(targetPlayer)
    if not jogadoresComBolas[targetPlayer] then return end
    local dados = jogadoresComBolas[targetPlayer]
    if dados.swayConnection then
        dados.swayConnection:Disconnect()
    end
    for _, part in ipairs(dados.partes) do
        if part and part.Parent then part:Destroy() end
    end
    if targetPlayer.Character and dados.roupas then
        restaurarRoupas(targetPlayer.Character, dados.roupas)
    end
    if dados.charConnection then
        dados.charConnection:Disconnect()
    end
    jogadoresComBolas[targetPlayer] = nil
end

