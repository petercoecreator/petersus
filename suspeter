            segmento.Material = materialLiso
            segmento.Color = skinColor
            segmento.CanCollide = false
            segmento.Parent = character

            local offsetZ = -0.7 - (i * alturaSegmento)
            segmento.CFrame = rootPart.CFrame * CFrame.new(0, -1.1, offsetZ) * CFrame.Angles(0, math.rad(90), 0)

            local w = Instance.new("WeldConstraint")
            w.Part0 = ultimoPai
            w.Part1 = segmento
            w.Parent = segmento

            table.insert(dados.segmentos, segmento)
            table.insert(dados.partes, segmento)
